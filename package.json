{
  "name": "c2000-epwm-tool",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "TI C2000 DSP ePWM 图形化设计器：时基求解、RED/FED 独立死区仿真、移相同步、SPWM/SVPWM 调制、Trip-Zone 保护、引脚复用与 C 代码生成",
  "keywords": [
    "c2000",
    "tms320f280039c",
    "tms320f28379d",
    "epwm",
    "deadband",
    "svpwm",
    "dsp",
    "codegen"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:restricted": "vitest run --configLoader native",
    "build:restricted": "tsc --noEmit && vite build --configLoader native"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
